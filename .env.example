# vroad-mltraining — IDs de Google (NO secretos). Copia a .env y rellena lo pendiente.
# Secretos -> Secret Manager. Con impersonación/WIF no hay claves JSON.

GCP_REGION=us-central1

# Proyectos
PROJECT_TRAINING=vr-prj-dev-training-v1
PROJECT_CICD=vr-prj-dev-cicd-v1
PROJECT_DATALAKE=vr-prj-prod-data-v1
PROJECT_VALIDATION=vr-prj-nonprod-validation-v1
DATALAKE_PROJECT_NUMBER=993161378963
TRAINING_PROJECT_NUMBER=476290100601
CICD_PROJECT_NUMBER=970801873572

# Artifact Registry / imágenes
AR_HOST=us-central1-docker.pkg.dev
AR_REPO=ml-training

# Modelo (lanetr pineado por SHA)
LANETR_REPO=https://github.com/VisualRoadLabs/vroad-lanetr
LANETR_SHA=dd2f8ab87a8071e34fd3511fc82e5c71def85e07

# Service Accounts
SA_TRAINER=sa-mlt-trainer@vr-prj-dev-training-v1.iam.gserviceaccount.com
SA_DATASET=sa-mlt-dataset@vr-prj-dev-training-v1.iam.gserviceaccount.com
SA_DASHBOARD=sa-mlt-dashboard@vr-prj-dev-training-v1.iam.gserviceaccount.com
SA_WORKFLOW=sa-mlt-workflow@vr-prj-dev-training-v1.iam.gserviceaccount.com

# Buckets
BUCKET_DATASETS=bkt-dev-datasets-usc1
BUCKET_WORKDIRS=bkt-dev-training-workdirs-usc1
BUCKET_HANDOFF=bkt-dev-training-handoff-usc1
BUCKET_VERTEX_STAGING=bkt-dev-vertex-staging-usc1

# Data Lake (solo lectura)
DATALAKE_IMAGES_PUBLIC=bkt-prod-public-usc1
DATALAKE_IMAGES_USER=bkt-prod-user-usc1

# BigQuery
BQ_DATASET_EXPERIMENTS=ds_experiments

# Vertex
VERTEX_TENSORBOARD=tb-dev-lanetr-usc1
ACCEL_ITER=NVIDIA_L4
MACHINE_ITER=g2-standard-12
ACCEL_FINAL=NVIDIA_TESLA_A100
MACHINE_FINAL=a2-highgpu-1g

# Concurrencia (locks de GPU)
LOCK_PREFIX=gs://bkt-dev-vertex-staging-usc1/locks
MAX_A100=1
MAX_L4=3
